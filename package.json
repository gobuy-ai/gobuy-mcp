{
  "name": "gobuy-product-trust",
  "version": "1.1.0",
  "description": "Marketplace-evidence trust scores for AI agents — a 0-100 Evidence Score with observed/missing signals for Amazon, Walmart, Target, and Best Buy listings. The reference evaluator for the GPV-1 Pre-Purchase Verification Specification.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "homepage": "https://gobuy.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gobuy-ai/gobuy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gobuy-ai/gobuy-mcp/issues"
  },
  "author": "GoBuy",
  "keywords": [
    "mcp",
    "mcp-server",
    "product-trust",
    "e-commerce",
    "reviews",
    "ai-agents",
    "marketplace",
    "evidence-score",
    "trust-layer",
    "agent-commerce"
  ]
}
