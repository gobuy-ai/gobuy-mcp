  "description": "Marketplace-evidence trust scores for AI agents — one call returns a 0–100 evidence index with full signal breakdown.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
